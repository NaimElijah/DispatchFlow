<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/>
	</parent>
	<groupId>com.dispatchflow</groupId>
	<artifactId>core</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>DispatchFlow core</name>
	<description>DispatchFlow core backend: the REST API and the system of record</description>
	<properties>
		<!-- Surefire and Failsafe run the tests in Israel's zone, the system's one zone (ADR-088), on
		     every machine, so CI runs as a developer's machine does and a test can't pass only because
		     the JVM's own zone happens to be UTC. -->
		<argLine>-Duser.timezone=Asia/Jerusalem</argLine>
		<java.version>25</java.version>
		<archunit.version>1.5.1</archunit.version>
		<jts.version>1.20.0</jts.version>
		<libphonenumber.version>9.0.44</libphonenumber.version>
		<openapi-generator.version>7.27.0</openapi-generator.version>
		<palantir-java-format.version>2.103.0</palantir-java-format.version>
		<spotless-maven-plugin.version>3.12.0</spotless-maven-plugin.version>
		<uuid-creator.version>6.1.1</uuid-creator.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.googlecode.libphonenumber</groupId>
			<artifactId>libphonenumber</artifactId>
			<version>${libphonenumber.version}</version>
		</dependency>
		<dependency>
			<groupId>org.locationtech.jts</groupId>
			<artifactId>jts-core</artifactId>
			<version>${jts.version}</version>
		</dependency>
		<!-- The JDK makes no UUID version 7, the IDs the kernel's typed IDs carry (tech_stack.md, section 6). -->
		<dependency>
			<groupId>com.github.f4b6a3</groupId>
			<artifactId>uuid-creator</artifactId>
			<version>${uuid-creator.version}</version>
		</dependency>
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<!-- The PostgreSQL init script that creates the two database roles, so the test containers
			     run the very file development runs (ADR-145). The image's build sees only this module
			     and the client API's contract, not infra/, and Maven skips a resource folder that
			     doesn't exist, as the image skips the tests. -->
			<testResource>
				<directory>${project.basedir}/../../../infra/deploy/postgres/initdb</directory>
				<targetPath>postgres-initdb</targetPath>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- The client API's Spring MVC interfaces and models, generated from the contract at every
			     build into target/generated-sources and never committed (ADR-043, ADR-140 decision 2,
			     ADR-160). `just gen` runs this execution alone. -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<executions>
					<execution>
						<id>client-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/../../../contracts/client-api/v1/openapi.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.dispatchflow.shared.adapter.in.web.api</apiPackage>
							<modelPackage>com.dispatchflow.shared.adapter.in.web.model</modelPackage>
							<modelNameSuffix>Dto</modelNameSuffix>
							<cleanupOutput>true</cleanupOutput>
							<!-- The two NullMarked package-info files alone: ApiUtil, the other supporting
							     file, serves only the default methods skipDefaultInterface leaves out
							     (ADR-160). -->
							<supportingFilesToGenerate>package-info.java</supportingFilesToGenerate>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelDocumentation>false</generateModelDocumentation>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot4>true</useSpringBoot4>
								<useJackson3>true</useJackson3>
								<useBeanValidation>true</useBeanValidation>
								<!-- No @Validated on the interfaces: with it, Spring MVC skips its own
								     argument validation, which answers the contract's 400 before the
								     handler starts, and an AOP proxy throws a ConstraintViolationException
								     from inside it instead (ADR-140 decision 9, ADR-160). -->
								<useSpringBuiltInValidation>true</useSpringBuiltInValidation>
								<useTags>true</useTags>
								<skipDefaultInterface>true</skipDefaultInterface>
								<openApiNullable>false</openApiNullable>
								<useJspecify>true</useJspecify>
								<useRecords>true</useRecords>
								<annotationLibrary>none</annotationLibrary>
								<documentationProvider>none</documentationProvider>
								<!-- No build time in the @Generated annotation, so two builds of one
								     contract write the same classes. -->
								<hideGenerationTimestamp>true</hideGenerationTimestamp>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Surefire runs *Test classes; Failsafe runs *IT classes, the ones that need Docker. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<!-- An address a developer might export, so the tests prove that @TomcatIntegrationTest's
				     loopback pin outranks it: the stand-in signs in every call its server takes (ADR-148). -->
				<configuration>
					<environmentVariables>
						<SERVER_ADDRESS>0.0.0.0</SERVER_ADDRESS>
					</environmentVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- spotless:check runs in validate, the first phase, so `mvnw verify` fails on unformatted
			     code before it compiles or tests anything; `mvnw spotless:apply` fixes it. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
						</palantirJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
