# The web app's development server, for infra/deploy/compose.dev.yaml alone (ADR-151). It is no
# production image: the deployed web app is a build that Caddy serves (tech_stack.md section 4).
# Its context is src/frontend, the pnpm workspace's root, so it sees the lockfile and the shared
# packages. Compose Watch syncs edits into /workspace and rebuilds the image when the lockfile
# changes, so the dependencies installed here never go stale.
FROM node:24-slim

# The images run as dispatchflow, uid 10001 (ADR-019).
RUN useradd --system --uid 10001 --create-home dispatchflow
WORKDIR /workspace
RUN chown dispatchflow /workspace

# pnpm at the version the workspace's package.json names in packageManager (ADR-141), the one place
# it is pinned, so the image installs as `just web-setup` does.
COPY package.json ./
RUN npm install --global "$(node -p "require('./package.json').packageManager")"
USER dispatchflow

# pnpm's Docker recipe. fetch reads the lockfile alone, in a layer of its own, so a source change
# downloads nothing, and the install reads the store alone, so a started container needs no outside
# network (NFR-175). The store sits in a BuildKit cache, outside every layer, so the image holds each
# package once, in node_modules.
COPY --chown=dispatchflow pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=dispatchflow-pnpm-store,target=/home/dispatchflow/.pnpm-store,uid=10001 \
    pnpm fetch --store-dir /home/dispatchflow/.pnpm-store
COPY --chown=dispatchflow . .
RUN --mount=type=cache,id=dispatchflow-pnpm-store,target=/home/dispatchflow/.pnpm-store,uid=10001 \
    pnpm install --offline --frozen-lockfile --store-dir /home/dispatchflow/.pnpm-store

EXPOSE 5173
# Inside the container the server must listen on every interface to be reached through its published
# port, which compose.dev.yaml binds to 127.0.0.1 on the host (ADR-140 decision 4).
CMD ["pnpm", "--filter", "dispatchflow-web", "run", "dev", "--host", "0.0.0.0"]
