# Local agent state — .claude/ itself stays tracked
.claude/settings.local.json

# Secrets — commit .env.example with keys and no values
.env
.env.*
*.env
!.env.example

# Terraform's local files, which can hold values in plain text: its state, plans, variable files
# and provider cache. The lock file, .terraform.lock.hcl, stays tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
crash.log

# Keys and certificates: they belong in a secret manager, never in the repository
*.pem
*.key
*.p12
*.jks

# Local logs: the folder is kept, its contents never committed, since logs can hold personal data
logs/*
!logs/.gitkeep

# Built data files (the OSM extract, OSRM files, PMTiles and benchmark instances): large, and
# rebuilt from their sources, so never committed (ADR-123). The folder itself is kept (ADR-130).
/data/*
!/data/.gitkeep

# Usability-study recordings and raw answers show the pilot's dispatcher and company data, so they
# stay on company storage in Israel, never in this public repository (NFR-209, FR-48)
/docs/research/usability/**/*.mkv
/docs/research/usability/**/*.mp4
/docs/research/usability/**/*.mov
/docs/research/usability/**/*.webm
/docs/research/usability/**/*.csv
/docs/research/usability/**/*.xlsx

# OS files
.DS_Store
Thumbs.db

# Build output and tool caches
target/
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
*.egg-info/
node_modules/
.expo/
dist/
build/
coverage/

# IDEs
.idea/
*.iml
.vscode/
