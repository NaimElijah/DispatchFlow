# The keys compose.dev.yaml reads, with no values. Copy this file to infra/deploy/.env, which git
# ignores, and fill in the three passwords; never commit them (NFR-03). Every other key has its
# value in compose.dev.yaml, so a .env with only the passwords filled starts the stack.
#
# An issue that adds a setting the core can't start without adds it, in the same pull request, to
# this file, to the core service in compose.dev.yaml and to src/backend/core/.env.example (ADR-151).
# A key that is no secret stays empty here: its value sits in compose.dev.yaml as ${KEY:-value}.

# The PostgreSQL superuser's password. Only the postgres container gets it.
POSTGRES_PASSWORD=

# The two database roles' passwords (ADR-041, ADR-145). postgres/initdb/create-roles.sql reads both
# when it creates the roles in an empty database, and stops when either is empty or both are the
# same; make each one with, for example, `openssl rand -base64 32`, and make all three passwords
# differ. A start that stopped there leaves the data folder without the roles, so remove its volume
# before starting again. The migrate step connects with the owner's and the core with app's, each
# through its own SPRING_DATASOURCE_PASSWORD; the core never gets the owner's.
DISPATCHFLOW_OWNER_PASSWORD=
DISPATCHFLOW_APP_PASSWORD=

# The seeded account the dev core's stand-in session acts as: dispatcher (the default), driver or
# admin (ADR-147).
DISPATCHFLOW_STANDIN_ACCOUNT=

# The laptop's port for the stack's PostgreSQL, 5432 by default. Set another when a PostgreSQL of
# the laptop's own already listens there, as a Windows install does. It binds 127.0.0.1 either way.
DISPATCHFLOW_POSTGRES_HOST_PORT=
