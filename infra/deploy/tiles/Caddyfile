# The dev stack's tiles service (ADR-042): it serves the map files that `just data` builds into
# data/tiles/, which the web app's dev server proxies under /map/ (#152). Caddy's file server
# answers Range requests with 206, which the PMTiles reader needs.
{
	# Nothing reconfigures this server while it runs, and it serves plain HTTP on the laptop only,
	# so it needs no admin endpoint, no certificates and no config it writes back.
	admin off
	auto_https off
	persist_config off
}

:8090 {
	# These files reach the browser on the web app's own origin, where a page could call /api/. No
	# answer may be read as a page: nosniff stops the browser guessing a type, the policy runs no
	# script if one is opened anyway, and the binary files get a type of their own, which Caddy
	# leaves empty for .pmtiles and .pbf.
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; sandbox"
	}
	@binary path *.pmtiles *.pbf
	header @binary Content-Type application/octet-stream

	# The health check's path, which answers before `just data` has built any file.
	respond /healthz 200

	root * /srv
	file_server
}
