# Where a language's formatter is configured, the formatter wins. This covers every other file
# and every editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,py}]
indent_size = 4

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

# cmd.exe needs CRLF to run a script.
[*.{cmd,bat}]
end_of_line = crlf

# caddy fmt indents with tabs.
[Caddyfile]
indent_style = tab
